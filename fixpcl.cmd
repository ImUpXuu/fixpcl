@echo off
title PCL 2.99.0.0 Repair Tool
cd /d "%~dp0"
echo Loading repair script (approx 1.6 MB, please wait)...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$dir = '%~dp0'; $c = [System.IO.File]::ReadAllText('%~f0', [System.Text.Encoding]::UTF8); $i = $c.IndexOf('#PS' + '_BODY'); Invoke-Expression $c.Substring($i)"
set EC=%ERRORLEVEL%
echo.
if "%EC%"=="0" (echo ===== REPAIR FINISHED. See messages above. =====) else (echo ===== FAILED, exit code %EC%. See messages above. =====)
pause
exit /b %EC%
#PS_BODY
# ================================================================
#  PCL 2.99.0.0 MC 下载功能一键修复（单文件版，双击即用）
#
#  用法：把本文件与官方 2.99.0.0 的 "Plain Craft Launcher 2.exe"
#        放在同一文件夹，双击本文件。成功后同目录生成
#        "Plain Craft Launcher 2.patched.exe"（原文件不动）。
#        若目录里没有 exe，会自动从 GitHub / jsdelivr 下载官方版。
#
#  可选环境变量：
#        PCL_EXE=路径     指定官方 exe 的位置
#        PCL_SMOKE=1      生成后自动启动 12 秒做冒烟测试
#
#  限制：仅支持官方 2.99.0.0；仅限个人使用，请勿分发补丁后的文件。
#        建议在 PCL 设置中关闭自动更新，以免补丁版被官方版覆盖。
# ================================================================
$ErrorActionPreference = 'Stop'
$ExePath = $env:PCL_EXE
function Write-Step($m) { Write-Host ('[*] ' + $m) -ForegroundColor Cyan }
function Write-Ok($m)   { Write-Host ('[+] ' + $m) -ForegroundColor Green }
function Write-Warn2($m){ Write-Host ('[!] ' + $m) -ForegroundColor Yellow }

$expectedVer = '2.99.0.0'

# ---- 0. 定位源 exe ---------------------------------------------------------
if (-not $ExePath) {
    $scriptDir = $null
    if ($dir) { $scriptDir = $dir }
    elseif ($PSScriptRoot) { $scriptDir = $PSScriptRoot }
    else { $scriptDir = (Get-Location).Path }
    $try = Join-Path $scriptDir 'Plain Craft Launcher 2.exe'
    if (Test-Path $try) { $ExePath = $try }
}
if (-not $ExePath) {
    Write-Step '未指定 exe，尝试从 GitHub 下载官方 2.99.0.0 ...'
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $zip = Join-Path $env:TEMP 'pcl-official-299.zip'
    $urls = @(
        'https://raw.githubusercontent.com/Meloong-Git/PCL/main/%E6%9C%80%E6%96%B0%E6%AD%A3%E5%BC%8F%E7%89%88.zip',
        'https://cdn.jsdelivr.net/gh/Meloong-Git/PCL@main/%E6%9C%80%E6%96%B0%E6%AD%A3%E5%BC%8F%E7%89%88.zip'
    )
    $got = $false
    foreach ($u in $urls) {
        try { Invoke-WebRequest -Uri $u -OutFile $zip -UseBasicParsing -TimeoutSec 180 | Out-Null; $got = $true; break }
        catch { Write-Warn2 ('下载源不可用: ' + $u) }
    }
    if (-not $got) { throw '无法自动下载官方 exe。请将官方 2.99.0.0 的 "Plain Craft Launcher 2.exe" 放到本脚本同目录后重试，或用 -ExePath 指定路径。' }
    $exDir = Join-Path $env:TEMP 'pcl-official-299'
    if (Test-Path $exDir) { Remove-Item $exDir -Recurse -Force }
    Expand-Archive -Path $zip -DestinationPath $exDir -Force
    $found = Get-ChildItem $exDir -Filter '*.exe' | Select-Object -First 1
    if (-not $found) { throw '下载的压缩包中没有 exe' }
    $ExePath = $found.FullName
    Write-Ok ('已下载官方 exe: ' + $ExePath)
}
$ExePath = [System.IO.Path]::GetFullPath($ExePath)
if (-not (Test-Path $ExePath)) { throw "找不到 exe: $ExePath" }

# ---- 1. 版本守卫 -----------------------------------------------------------
$fv = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($ExePath).FileVersion
if ($fv -ne $expectedVer) { throw "版本不匹配：本工具仅支持官方 $expectedVer，检测到 '$fv'。请勿对其他版本使用。" }
Write-Ok "目标: $ExePath (v$fv)"

# ---- 2. 释放内嵌 dnlib -----------------------------------------------------
$DnlibB64 = ''
$workDir = Join-Path $env:TEMP ('PCLPatch-' + [Guid]::NewGuid().ToString('N').Substring(0, 8))
New-Item -ItemType Directory -Force -Path $workDir | Out-Null
[void][System.Reflection.Assembly]::Load([Convert]::FromBase64String($DnlibB64))   # Load(bytes): 不锁文件
$Op = [dnlib.DotNet.Emit.OpCodes]
Write-Ok 'dnlib 已加载'

# ---- 3. 提取目标 exe 内嵌依赖（供 P1 导入 Dialogs.SelectFile）----------------
$embedDir = Join-Path $workDir 'embed'
New-Item -ItemType Directory -Force -Path $embedDir | Out-Null
$roAsm = [System.Reflection.Assembly]::ReflectionOnlyLoadFrom($ExePath)
$rdr = New-Object System.Resources.ResourceReader($roAsm.GetManifestResourceStream('PCL.Resources.resources'))
foreach ($e in $rdr) { if ($e.Value -is [byte[]]) { [System.IO.File]::WriteAllBytes((Join-Path $embedDir ($e.Key + '.dll')), $e.Value) } }
$rdr.Close()
foreach ($f in (Get-ChildItem $embedDir -Filter *.dll)) {
    try { [void][System.Reflection.Assembly]::LoadFrom($f.FullName) } catch { }
}
$selectFileMI = $null
foreach ($t in [System.Reflection.Assembly]::LoadFrom((Join-Path $embedDir 'MeloongCore.Wpf.dll')).GetTypes()) {
    if ($t.Name -eq 'Dialogs') { $selectFileMI = $t.GetMethod('SelectFile', [System.Reflection.BindingFlags]'Public,Static'); break }
}
if (-not $selectFileMI) { throw '内嵌 MeloongCore.Wpf 中未找到 Dialogs.SelectFile（版本结构变化？）' }
Write-Ok 'Dialogs.SelectFile 引用就绪'

# ---- 4. 加载模块 -----------------------------------------------------------
$module = [dnlib.DotNet.ModuleDefMD]::Load($ExePath)
$importer = New-Object dnlib.DotNet.Importer($module)
function GetTypeDef($fullName) {
    $t = @($module.Types | Where-Object { $_.FullName -eq $fullName })
    if ($t.Count -ne 1) { throw "类型定位失败 ($($t.Count)): $fullName —— 文件结构可能不是预期的 2.99.0.0" }
    return $t[0]
}
function NewI4([int]$v) {
    switch ($v) {
        0 { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldc_I4_0) }
        1 { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldc_I4_1) }
        2 { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldc_I4_2) }
        default { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldc_I4, [int32]$v) }
    }
}
Write-Step '开始打补丁 ...'

# ============================ P5: 版本修改页 MC 卡片可见 ======================
$pdm = GetTypeDef 'PCL.PageDownloadModify'
$p5 = 0
foreach ($m in $pdm.Methods) {
    if (-not $m.Body) { continue }
    $ins = $m.Body.Instructions
    for ($i = 0; $i -lt $ins.Count - 2; $i++) {
        if ($ins[$i].Operand -and $ins[$i].Operand.ToString() -like '*get_CardMinecraft*' -and
            $ins[$i+1].OpCode.Name -eq 'ldc.i4.2' -and
            $ins[$i+2].Operand -and $ins[$i+2].Operand.ToString() -like '*set_Visibility*') {
            $ins[$i+1] = NewI4 0
            $p5++
        }
    }
}
if ($p5 -ne 1) { throw "P5 失败：预期 1 处折叠点，找到 $p5 处" }
Write-Ok 'P5  版本修改页 MC 卡片 -> Visible'

# ============================ P3: 下载页加载器 ================================
$modDownload = GetTypeDef 'PCL.ModDownload'
$dlField = @($modDownload.Fields | Where-Object { $_.Name -eq 'DlClientListLoader' })
if ($dlField.Count -ne 1) { throw 'P3 失败：DlClientListLoader 字段缺失' }
$dlField = $dlField[0]

$pdi = GetTypeDef 'PCL.PageDownloadInstall'
$loaderInit = @($pdi.Methods | Where-Object { $_.Name -eq 'LoaderInit' -and -not $_.HasParameters })
if ($loaderInit.Count -ne 1) { throw 'P3 失败：LoaderInit 缺失' }
$ins = $loaderInit[0].Body.Instructions
$startIdx = -1
for ($i = 0; $i -lt $ins.Count; $i++) {
    if ($ins[$i].OpCode.Name -eq 'ldstr' -and $ins[$i].Operand -eq [string]'关闭下载') { $startIdx = $i; break }
}
if ($startIdx -lt 0) { throw 'P3 失败：未找到 "关闭下载" 标记' }
$endIdx = -1
for ($i = $startIdx; $i -lt $ins.Count; $i++) {
    if ($ins[$i].OpCode.Name -eq 'newobj' -and $ins[$i].Operand.ToString() -like 'System.Void PCL.ModLoader/LoaderTask*') { $endIdx = $i; break }
}
if ($endIdx -lt 0) { throw 'P3 失败：假加载器构造未找到' }
$j = $endIdx + 1
while ($j -lt $ins.Count -and $ins[$j].OpCode.Name -notlike 'call*') { $j++ }
if ($ins[$j].Operand.ToString() -notlike '*PageLoaderInit*') { throw 'P3 失败：结构校验不过（PageLoaderInit 位置异常）' }
for ($i = $endIdx; $i -ge $startIdx; $i--) { $ins.RemoveAt($i) }
$ins.Insert($startIdx, [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldsfld, $dlField))
Write-Ok ('P3  下载页加载器 -> DlClientListLoader (移除 ' + ($endIdx - $startIdx + 1) + ' 条指令)')

# ============================ P2: 整合包安装调度 ================================
$modModpack = GetTypeDef 'PCL.ModModpack'
$mi3 = @($modModpack.Methods | Where-Object { $_.Name -eq 'ModpackInstall' -and $_.Parameters.Count -eq 3 })
if ($mi3.Count -ne 1) { throw 'P2 失败：ModpackInstall(File...) 缺失' }
$mi3 = $mi3[0]
$ips = @{}
foreach ($nm in 'InstallPackCurseForge','InstallPackHMCL','InstallPackMMC','InstallPackMCBBS','InstallPackModrinth','InstallPackLauncherPack','InstallPackCompress') {
    $mm = @($modModpack.Methods | Where-Object { $_.Name -eq $nm })
    if ($mm.Count -lt 1) { throw "P2 失败：$nm 方法缺失" }
    $ips[$nm] = $mm[0]
}
$body = $mi3.Body
$ins = $body.Instructions
$thrIdx = -1
for ($i = 0; $i -lt $ins.Count - 2; $i++) {
    if ($ins[$i].OpCode.Name -eq 'ldstr' -and $ins[$i].Operand -like '*法律法规*' -and
        $ins[$i+1].OpCode.Name -eq 'newobj' -and $ins[$i+2].OpCode.Name -eq 'throw') { $thrIdx = $i; break }
}
if ($thrIdx -lt 0) { throw 'P2 失败：限制 throw 未找到' }
$logInfoOp = $null
foreach ($x in $ins) {
    if ($x.OpCode.Name -eq 'call' -and $x.Operand -and $x.Operand.ToString() -like '*Logger::Info(System.String,MeloongCore.LogBehavior,System.String)') { $logInfoOp = $x.Operand; break }
}
if (-not $logInfoOp) { throw 'P2 失败：Logger.Info 引用未找到' }
$resVar = $body.Variables[0]
if ($body.Variables[1].Type.FullName -notlike '*ZipArchive*') { throw 'P2 失败：局部变量布局与预期不符' }
if ($body.Variables[4].Type.FullName -ne 'System.Int32') { throw 'P2 失败：局部变量布局与预期不符' }
$efIdx = -1
for ($i = $thrIdx + 2; $i -lt $ins.Count; $i++) {
    if ($ins[$i].OpCode.Name -eq 'endfinally') { $efIdx = $i; break }
}
if ($efIdx -lt 0) { throw 'P2 失败：endfinally 未找到' }
if ($efIdx + 1 -lt $ins.Count) { $leaveTarget = $ins[$efIdx + 1] }
else {
    $epi1 = [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc, $resVar)
    $epi2 = [dnlib.DotNet.Emit.Instruction]::Create($Op::Ret)
    $ins.Add($epi1); $ins.Add($epi2)
    $leaveTarget = $epi1
}
function Emit-Load([string]$what) {
    switch ($what) {
        'File' { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldarg_0) }
        'Name' { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldarg_1) }
        'Logo' { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldarg_2) }
        'Arc'  { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc, $script:body2.Variables[1]) }
        'Base' { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc, $script:body2.Variables[2]) }
    }
}
$script:body2 = $body
function Build-Case([string]$logMsg, $installMethod, [string[]]$argPat) {
    $list = New-Object System.Collections.Generic.List[dnlib.DotNet.Emit.Instruction]
    $list.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldstr, $logMsg))
    $list.Add((NewI4 0))
    $list.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldstr, 'E:\Projects\PCL\本体代码\Plain Craft Launcher 2\Modules\Minecraft\ModModpack.vb'))
    $list.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Call, $script:logInfoOp2))
    foreach ($a in $argPat) { $list.Add((Emit-Load $a)) }
    $list.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Call, $installMethod))
    $list.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Stloc, $script:resVar2))
    $list.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Leave, $script:leaveTarget2))
    return ,$list.ToArray()
}
$script:logInfoOp2 = $logInfoOp
$script:resVar2 = $resVar
$script:leaveTarget2 = $leaveTarget
$caseD = Build-Case '整合包种类：未能识别，假定为压缩包' $ips['InstallPackCompress'] @('File','Arc')
$case0 = Build-Case '整合包种类：CurseForge'  $ips['InstallPackCurseForge']    @('File','Arc','Base','Name','Logo')
$case1 = Build-Case '整合包种类：HMCL'        $ips['InstallPackHMCL']          @('File','Arc','Base')
$case2 = Build-Case '整合包种类：MMC'         $ips['InstallPackMMC']           @('File','Arc','Base')
$case3 = Build-Case '整合包种类：MCBBS'       $ips['InstallPackMCBBS']         @('File','Arc','Base','Name')
$case4 = Build-Case '整合包种类：Modrinth'    $ips['InstallPackModrinth']      @('File','Arc','Base','Name','Logo')
$case9 = Build-Case '整合包种类：带启动器的压缩包' $ips['InstallPackLauncherPack'] @('File','Arc','Base')
$targets = @($case0[0], $case1[0], $case2[0], $case3[0], $case4[0], $caseD[0], $caseD[0], $caseD[0], $caseD[0], $case9[0])
$newBlock = New-Object System.Collections.Generic.List[dnlib.DotNet.Emit.Instruction]
$newBlock.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc, $body.Variables[4]))
$newBlock.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Switch, [dnlib.DotNet.Emit.Instruction[]]$targets))
foreach ($c in @($caseD, $case0, $case1, $case2, $case3, $case4, $case9)) { foreach ($x in $c) { $newBlock.Add($x) } }
# 原地改写 throw 三连（throw 是外层 Try 的末条指令，删除会悬空异常处理边界）
$ins[$thrIdx].OpCode = $newBlock[0].OpCode
$ins[$thrIdx].Operand = $newBlock[0].Operand
$ins[$thrIdx + 1].OpCode = $newBlock[1].OpCode
$ins[$thrIdx + 1].Operand = $newBlock[1].Operand
$ins[$thrIdx + 2].OpCode = $newBlock[2].OpCode
$ins[$thrIdx + 2].Operand = $newBlock[2].Operand
$idx = $thrIdx + 3
for ($k = 3; $k -lt $newBlock.Count; $k++) { $ins.Insert($idx, $newBlock[$k]); $idx++ }
function Find-CaseStart([string]$msg) {
    for ($i = 0; $i -lt $ins.Count; $i++) {
        if ($ins[$i].OpCode.Name -eq 'ldstr' -and $ins[$i].Operand -eq $msg) { return $ins[$i] }
    }
    throw "P2 失败：case 标记未找到: $msg"
}
$t0 = Find-CaseStart '整合包种类：CurseForge'
$t1 = Find-CaseStart '整合包种类：HMCL'
$t2 = Find-CaseStart '整合包种类：MMC'
$t3 = Find-CaseStart '整合包种类：MCBBS'
$t4 = Find-CaseStart '整合包种类：Modrinth'
$t9 = Find-CaseStart '整合包种类：带启动器的压缩包'
$tD = Find-CaseStart '整合包种类：未能识别，假定为压缩包'
$ins[$thrIdx + 1].Operand = [dnlib.DotNet.Emit.Instruction[]]@($t0, $t1, $t2, $t3, $t4, $tD, $tD, $tD, $tD, $t9)
Write-Ok ('P2  整合包安装调度已重建 (' + $newBlock.Count + ' 条指令)')

# ============================ P1: 无参安装入口 ================================
$mi0 = @($modModpack.Methods | Where-Object { $_.Name -eq 'ModpackInstall' -and $_.Parameters.Count -eq 0 })
if ($mi0.Count -ne 1) { throw 'P1 失败：ModpackInstall() 缺失' }
$mi0 = $mi0[0]
$closureType = @($modModpack.NestedTypes | Where-Object { $_.Name -like '_Closure$__0-0' })
if ($closureType.Count -ne 1) { throw 'P1 失败：闭包类型缺失' }
$closureType = $closureType[0]
$closureCtor = @($closureType.Methods | Where-Object { $_.IsConstructor })[0]
$closureField = @($closureType.Fields | Where-Object { $_.FieldType.FullName -eq 'System.String' })
if ($closureField.Count -ne 1) { throw 'P1 失败：闭包字段缺失' }
$closureField = $closureField[0]
$lambda = @($closureType.Methods | Where-Object { $_.Name -like '_Lambda*' })
if ($lambda.Count -lt 1) { throw 'P1 失败：闭包 lambda 缺失' }
$lambda = $lambda[0]
$runInThread = @((GetTypeDef 'PCL.ModBase').Methods | Where-Object { $_.Name -eq 'RunInThread' -and $_.Parameters.Count -eq 1 })
if ($runInThread.Count -ne 1) { throw 'P1 失败：RunInThread 缺失' }
$runInThread = $runInThread[0]

$selectFileRef = $importer.Import($selectFileMI)
$actionCtorRef = $importer.Import([System.Action].GetConstructor([type[]]@([object], [intptr])))
$isNullOrEmptyRef = $importer.Import([string].GetMethod('IsNullOrEmpty'))
$listCountRef = $importer.Import([System.Collections.Generic.List[string]].GetProperty('Count').GetGetMethod())
$listItemRef = $importer.Import([System.Collections.Generic.List[string]].GetProperty('Item').GetGetMethod())

$body = $mi0.Body
$closureSig = $body.Variables[0].Type
if ($closureSig.FullName -ne $closureType.FullName) { throw 'P1 失败：闭包局部变量类型不符' }
$listStrTypeSig = $null
:outer foreach ($t in $module.Types) {
    foreach ($m in $t.Methods) {
        if (-not $m.Body) { continue }
        foreach ($v in $m.Body.Variables) {
            if ($v.Type.FullName -eq 'System.Collections.Generic.List`1<System.String>') { $listStrTypeSig = $v.Type; break outer }
        }
    }
}
if (-not $listStrTypeSig) { throw 'P1 失败：模块中无可复用的 List<string> 类型签名' }

$body.Instructions.Clear()
$body.Variables.Clear()
[void]$body.Variables.Add((New-Object dnlib.DotNet.Emit.Local($closureSig, 'closure')))
[void]$body.Variables.Add((New-Object dnlib.DotNet.Emit.Local($listStrTypeSig, 'files')))
$I = New-Object System.Collections.Generic.List[dnlib.DotNet.Emit.Instruction]
function INS($instr) { $script:I.Add($instr) | Out-Null }
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Newobj, $closureCtor))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Stloc_0))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldstr, '选择整合包压缩文件'))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldc_I4_0))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldnull))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldnull))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Call, $selectFileRef))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Stloc_1))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc_1))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Callvirt, $listCountRef))
$brFiles = New-Object dnlib.DotNet.Emit.Instruction($Op::Brtrue, $null); INS $brFiles
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ret))
$L1 = [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc_0); INS $L1
$brFiles.Operand = $L1
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc_1))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldc_I4_0))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Callvirt, $listItemRef))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Stfld, $closureField))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc_0))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldfld, $closureField))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Call, $isNullOrEmptyRef))
$brGo = New-Object dnlib.DotNet.Emit.Instruction($Op::Brfalse, $null); INS $brGo
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ret))
$L2 = [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc_0); INS $L2
$brGo.Operand = $L2
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc_0))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldftn, $lambda))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Newobj, $actionCtorRef))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Call, $runInThread))
INS ([dnlib.DotNet.Emit.Instruction]::Create($Op::Ret))
foreach ($x in $I) { $body.Instructions.Add($x) }
Write-Ok 'P1  整合包安装入口已重建'

# ============================ P6: 资源详情页安装按钮 ============================
$prd = GetTypeDef 'PCL.PageDownloadResourceDetail'
$initStack = @($prd.Methods | Where-Object { $_.Name -eq 'InitializeStackResourceVersions' })
if ($initStack.Count -ne 1) { throw 'P6 失败：InitializeStackResourceVersions 缺失' }
$initStack = $initStack[0]
$installClick = @($prd.Methods | Where-Object { $_.Name -eq 'Install_Click' })
if ($installClick.Count -lt 1) { throw 'P6 失败：Install_Click 缺失' }
$installClick = $installClick[0]
$saveClick = @($prd.Methods | Where-Object { $_.Name -eq 'Save_Click' })
if ($saveClick.Count -lt 1) { throw 'P6 失败：Save_Click 缺失' }
$saveClick = $saveClick[0]
$trf = @($prd.Fields | Where-Object { $_.Name -eq 'TargetResourceType' })
if ($trf.Count -ne 1) { throw 'P6 失败：TargetResourceType 缺失' }
$trf = $trf[0]
$clickehCtor = @((@(GetTypeDef 'PCL.MyListItem').NestedTypes | Where-Object { $_.Name -eq 'ClickEventHandler' })[0].Methods | Where-Object { $_.IsConstructor })[0]
$icoehCtor = @((@(GetTypeDef 'PCL.MyIconButton').NestedTypes | Where-Object { $_.Name -eq 'ClickEventHandler' })[0].Methods | Where-Object { $_.IsConstructor })[0]

$body = $initStack.Body
$ins = $body.Instructions
$blockStart = -1; $blockEnd = -1
$childrenOp = $null; $toListOp = $null; $addOp = $null
for ($i = 0; $i -lt $ins.Count - 8; $i++) {
    if ($ins[$i].OpCode.Name -eq 'ldarg.1' -and $ins[$i+1].OpCode.Name -like 'callvirt*' -and
        $ins[$i+1].Operand.ToString() -like '*Panel::get_Children*') {
        for ($j = $i + 2; $j -lt [Math]::Min($i + 20, $ins.Count - 2); $j++) {
            if ($ins[$j].Operand -and $ins[$j].Operand.ToString() -like '*ResourceVersion::ToListItem*' -and
                $ins[$j+1].Operand.ToString() -like '*UIElementCollection::Add*' -and $ins[$j+2].OpCode.Name -eq 'pop') {
                $blockStart = $i; $blockEnd = $j + 2
                $childrenOp = $ins[$i+1].Operand; $toListOp = $ins[$j].Operand; $addOp = $ins[$j+1].Operand
                break
            }
        }
        if ($blockStart -ge 0) { break }
    }
}
if ($blockStart -lt 0) { throw 'P6 失败：目标指令块未找到' }
$verLocalIns = $ins[$blockStart + 2]
if ($verLocalIns.OpCode.Name -notlike 'ldloc*') { throw 'P6 失败：版本局部变量未找到' }
$hasDupIns = $null
for ($k = $blockEnd - 1; $k -ge $blockEnd - 4; $k--) {
    if ($ins[$k].OpCode.Name -like 'ldloc*') { $hasDupIns = $ins[$k]; break }
}
if (-not $hasDupIns) { throw 'P6 失败：HasDuplicates 局部变量未找到' }
$afterBlock = $ins[$blockEnd + 1]
$origBlock = @()
for ($i = $blockStart; $i -le $blockEnd; $i++) { $origBlock += $ins[$i] }
function Clone-StackIns($src) {
    if ($src.Operand) { return [dnlib.DotNet.Emit.Instruction]::Create($Op::Ldloc, $src.Operand) }
    return [dnlib.DotNet.Emit.Instruction]::Create($src.OpCode)
}
$N = New-Object System.Collections.Generic.List[dnlib.DotNet.Emit.Instruction]
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldarg_0))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldfld, $trf))
$N.Add((NewI4 2))
$brElse = New-Object dnlib.DotNet.Emit.Instruction($Op::Bne_Un, $null); $N.Add($brElse)
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldarg_1))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Callvirt, $childrenOp))
$N.Add((Clone-StackIns $verLocalIns))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldarg_0))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldftn, $installClick))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Newobj, $clickehCtor))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldarg_0))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ldftn, $saveClick))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Newobj, $icoehCtor))
$N.Add((Clone-StackIns $hasDupIns))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Callvirt, $toListOp))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Callvirt, $addOp))
$N.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Pop))
$brEnd = New-Object dnlib.DotNet.Emit.Instruction($Op::Br, $null); $N.Add($brEnd)
$elseStart = $origBlock[0]
foreach ($x in $origBlock) { $N.Add($x) }
$brElse.Operand = $elseStart
$brEnd.Operand = $afterBlock
for ($i = $blockEnd; $i -ge $blockStart; $i--) { $ins.RemoveAt($i) }
$idx = $blockStart
foreach ($x in $N) { $ins.Insert($idx, $x); $idx++ }
Write-Ok ('P6  资源详情页安装分支已恢复 (' + $N.Count + ' 条指令)')

# ============================ P7: 禁用自更新 ==================================
# 所有更新路径（服务器推送的 slientupdate 静默更新 / update 弹窗更新 / 手动按钮）
# 最终都调用 ModSecret.UpdateStart 下载并替换本体。将其方法体替换为单条 ret，
# 自更新永久失效，防止补丁版被官方受限版覆盖；整合包打包用的 DownloadLatestPCL
# 是独立方法，不受影响。
$modSecretT = GetTypeDef 'PCL.ModSecret'
$us = @($modSecretT.Methods | Where-Object { $_.Name -eq 'UpdateStart' -and $_.Parameters.Count -eq 2 })
if ($us.Count -ne 1) { throw 'P7 失败：UpdateStart 缺失' }
$us = $us[0]
if ($us.ReturnType.FullName -ne 'System.Void') { throw 'P7 失败：UpdateStart 签名异常' }
$newBody = New-Object dnlib.DotNet.Emit.CilBody
[void]$newBody.Instructions.Add([dnlib.DotNet.Emit.Instruction]::Create($Op::Ret))
$us.Body = $newBody
Write-Ok 'P7  自更新执行器 UpdateStart 已禁用（服务器推送与手动更新均不再下载替换）'

# ---- 5. 写盘前校验：无悬空引用 ---------------------------------------------
$bad = 0
foreach ($t in $module.Types) {
    foreach ($m in $t.Methods) {
        if (-not $m.Body) { continue }
        $set = New-Object 'System.Collections.Generic.HashSet[dnlib.DotNet.Emit.Instruction]'
        foreach ($x in $m.Body.Instructions) { [void]$set.Add($x) }
        foreach ($x in $m.Body.Instructions) {
            if ($x.Operand -is [dnlib.DotNet.Emit.Instruction] -and -not $set.Contains($x.Operand)) { Write-Host ('悬空分支: ' + $m.FullName); $bad++ }
            if ($x.Operand -is [dnlib.DotNet.Emit.Instruction[]]) {
                foreach ($tt in $x.Operand) { if (-not $set.Contains($tt)) { Write-Host ('悬空switch: ' + $m.FullName); $bad++ } }
            }
        }
        foreach ($eh in $m.Body.ExceptionHandlers) {
            foreach ($pin in @($eh.TryStart, $eh.TryEnd, $eh.HandlerStart, $eh.HandlerEnd, $eh.FilterStart)) {
                if ($pin -and -not $set.Contains($pin)) { Write-Host ('悬空EH: ' + $m.FullName); $bad++ }
            }
        }
    }
    foreach ($nt in $t.NestedTypes) {
        foreach ($m in $nt.Methods) {
            if (-not $m.Body) { continue }
            $set = New-Object 'System.Collections.Generic.HashSet[dnlib.DotNet.Emit.Instruction]'
            foreach ($x in $m.Body.Instructions) { [void]$set.Add($x) }
            foreach ($x in $m.Body.Instructions) {
                if ($x.Operand -is [dnlib.DotNet.Emit.Instruction] -and -not $set.Contains($x.Operand)) { $bad++ }
            }
            foreach ($eh in $m.Body.ExceptionHandlers) {
                foreach ($pin in @($eh.TryStart, $eh.TryEnd, $eh.HandlerStart, $eh.HandlerEnd, $eh.FilterStart)) {
                    if ($pin -and -not $set.Contains($pin)) { $bad++ }
                }
            }
        }
    }
}
if ($bad -gt 0) { throw "写盘前校验失败：$bad 处悬空引用（已中止，未生成文件）" }
Write-Ok '写盘前校验通过（无悬空引用）'

# ---- 6. 写盘 ---------------------------------------------------------------
$dir = [System.IO.Path]::GetDirectoryName($ExePath)
$base = [System.IO.Path]::GetFileNameWithoutExtension($ExePath)
$outExe = Join-Path $dir ($base + '.patched.exe')
if (Test-Path $outExe) { Remove-Item $outExe -Force }
$module.Write($outExe)
Write-Ok "已生成: $outExe"

# ---- 7. 写盘后复检（重新加载，验证 5 处补丁标记）-----------------------------
$chk = [dnlib.DotNet.ModuleDefMD]::Load($outExe)
function Chk-Type($n) { return @($chk.Types | Where-Object { $_.FullName -eq $n })[0] }
$v3m = @((Chk-Type 'PCL.PageDownloadInstall').Methods | Where-Object { $_.Name -eq 'LoaderInit' })[0]
$v3ok = $false
foreach ($x in $v3m.Body.Instructions) {
    if ($x.OpCode.Name -eq 'ldsfld' -and $x.Operand -and $x.Operand.ToString() -like '*DlClientListLoader*') { $v3ok = $true }
}
if (-not $v3ok) { throw '复检失败：P3 未生效' }
$v2m = @((Chk-Type 'PCL.ModModpack').Methods | Where-Object { $_.Name -eq 'ModpackInstall' -and $_.Parameters.Count -eq 3 })[0]
$v2sw = $false; $v2calls = 0
foreach ($x in $v2m.Body.Instructions) {
    if ($x.OpCode.Name -eq 'switch') { $v2sw = $true }
    if ($x.OpCode.Name -like 'call*' -and $x.Operand -and $x.Operand.ToString() -like '*InstallPack*') { $v2calls++ }
}
if (-not ($v2sw -and $v2calls -ge 7)) { throw "复检失败：P2 未生效 (switch=$v2sw, calls=$v2calls)" }
$v1m = @((Chk-Type 'PCL.ModModpack').Methods | Where-Object { $_.Name -eq 'ModpackInstall' -and $_.Parameters.Count -eq 0 })[0]
$v1a = $false; $v1b = $false
foreach ($x in $v1m.Body.Instructions) {
    if ($x.Operand -and $x.Operand.ToString() -like '*Dialogs::SelectFile*') { $v1a = $true }
    if ($x.Operand -and $x.Operand.ToString() -like '*RunInThread*') { $v1b = $true }
}
if (-not ($v1a -and $v1b)) { throw '复检失败：P1 未生效' }
$v5ok = $true
foreach ($m in (Chk-Type 'PCL.PageDownloadModify').Methods) {
    if (-not $m.Body) { continue }
    $ii = $m.Body.Instructions
    for ($i = 0; $i -lt $ii.Count - 2; $i++) {
        if ($ii[$i].Operand -and $ii[$i].Operand.ToString() -like '*get_CardMinecraft*' -and $ii[$i+1].OpCode.Name -eq 'ldc.i4.2' -and $ii[$i+2].Operand -and $ii[$i+2].Operand.ToString() -like '*set_Visibility*') { $v5ok = $false }
    }
}
if (-not $v5ok) { throw '复检失败：P5 未生效' }
$v6m = @((Chk-Type 'PCL.PageDownloadResourceDetail').Methods | Where-Object { $_.Name -eq 'InitializeStackResourceVersions' })[0]
$v6ok = $false
foreach ($x in $v6m.Body.Instructions) {
    if ($x.OpCode.Name -eq 'ldftn' -and $x.Operand -and $x.Operand.ToString() -like '*Install_Click*') { $v6ok = $true }
}
if (-not $v6ok) { throw '复检失败：P6 未生效' }
$v7m = @((Chk-Type 'PCL.ModSecret').Methods | Where-Object { $_.Name -eq 'UpdateStart' -and $_.Parameters.Count -eq 2 })[0]
if (-not ($v7m.Body.Instructions.Count -eq 1 -and $v7m.Body.Instructions[0].OpCode.Name -eq 'ret')) { throw '复检失败：P7 未生效' }
Write-Ok '写盘后复检通过：P1/P2/P3/P5/P6/P7 全部生效'

# ---- 8. 可选冒烟测试 ---------------------------------------------------------
if ($env:PCL_SMOKE -eq '1') {
    Write-Step '冒烟测试：启动 12 秒 ...'
    $p = Start-Process -FilePath $outExe -PassThru
    Start-Sleep -Seconds 12
    if ($p.HasExited) { Write-Warn2 ('进程提前退出，退出码 ' + $p.ExitCode + '（请人工检查）') }
    else { Write-Ok ('运行正常 (pid=' + $p.Id + ')，即将关闭'); Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue }
}

Remove-Item $workDir -Recurse -Force -ErrorAction SilentlyContinue
Write-Host ''
Write-Ok '全部完成。'
Write-Host ('    补丁文件: ' + $outExe)
Write-Host '    注意: 1) 仅限个人使用，请勿分发;  2) 已自动禁用自更新（P7），补丁版不会被官方版覆盖。'
